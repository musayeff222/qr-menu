{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "test:password": "tsx --test qa/password-hash.node.test.ts",
    "test:staging": "tsx --test --test-concurrency=1 qa/staging-safety.node.test.ts",
    "check:schema": "tsx scripts/check-schema.ts",
    "test:skins": "playwright test --config=playwright.config.ts && node qa/playwright/merge-qa.mjs && node qa/playwright/generate-gallery.mjs",
    "test:skins:gallery": "node qa/playwright/generate-gallery.mjs",
    "start": "node server.js",
    "deploy:build": "npm run build",
    "seed:demae": "tsx seedDemaeRestaurant.ts",
    "seed:demae:replace": "tsx seedDemaeRestaurant.ts --replace",
    "seed:demae:images": "tsx seedDemaeRestaurant.ts --images"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "knex": "^3.2.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "multer": "^2.1.1",
    "mysql2": "^3.20.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.0.3"
  }
}
