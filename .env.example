# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database: leave MYSQL_* unset to use SQLite (./qrmenu.sqlite or SQLITE_PATH).
# For MySQL, set either DATABASE_URL or the host variables below.
# DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/qrmenu"
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=secret
# MYSQL_DATABASE=qrmenu
# SQLITE_PATH=./qrmenu.sqlite
#
# NODE_ENV=production refuses SQLite unless ALLOW_SQLITE=on (local QA only).
# Hostinger production: set MYSQL_HOST (or DATABASE_URL). Do not set ALLOW_SQLITE.
# ALLOW_SQLITE=on
#
# Boot ALTER TABLE: SQLite default on; MySQL default off. Staging first schema fill:
# DB_AUTO_MIGRATE=off
# DB_AUTO_MIGRATE=on
#
# Known demo/admin123 seeds: off when NODE_ENV=production. Local Playwright: ALLOW_DEMO_SEED=on.
# ALLOW_DEMO_SEED=off
#
# First production/staging admin (not admin123 / demo123 / demae123):
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_PASSWORD=use-a-unique-password
#
# Isolated schema inspect (never against live MySQL from a laptop unless staging):
# npm run check:schema

# Password hashing (bcrypt cost 12). Default off: dual-read still verifies hashes,
# but new writes stay plaintext until you set on. Hashed rows keep working if you
# turn this back off. Do not roll back to old WHERE password= code after hashing.
# PASSWORD_HASHING=off
# PASSWORD_HASHING=on

# menugo.az / Hostinger Node.js:
# NODE_ENV=production
# PORT — panel tərəfindən təyin olunur (əl ilə 3000 yazmayın)
# Build: npm install --include=dev && npm run build
# Start: npm start
# Node: 20.19+ or 22.12+ (Vite 8)
#
# Demae menyu (bir dəfə SSH-dan, server işləyərkən DEYİL):
# MYSQL_HOST=... npm run seed:demae

# Şəkillər (cihazdan yükləmə) — Node.js deploy qovluğundan KƏNAR saxlayın.
# Təyin olunmasa production-da avtomatik: ../../private_uploads (domain səviyyəsi)
# Hostinger nümunəsi:
# UPLOADS_DIR=/home/USER/domains/menugo.az/private_uploads
# APP_URL=https://menugo.az
#
# Hostinger Environment Variables panelində əlavə edin; deploy-dan sonra server log-da
# "Uploads directory: ..." sətri tətbiq qovluğunun XARİCİNDƏ olmalıdır.
